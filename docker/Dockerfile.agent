# syntax=docker/dockerfile:1

# Binaires de l'agent et de l'assistant de session pour Linux, liés à la
# glibc 2.28 d'AlmaLinux 8 : ils tournent ainsi sur Debian 10+, Ubuntu 20.04+,
# RHEL 8+, Fedora, openSUSE, Arch… L'assistant ne dépend d'aucune bibliothèque
# graphique : il parle au bureau par D-Bus.
#
#   docker buildx build -f docker/Dockerfile.agent --output type=local,dest=dist .
#
# dépose dist/cotutelle-agent et dist/cotutelle-session, pour l'architecture
# de la machine.

FROM almalinux:8 AS build
RUN dnf install -y gcc && dnf clean all
ENV PATH=/root/.cargo/bin:$PATH
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --profile minimal --default-toolchain none
WORKDIR /src
# La version de Rust vient de rust-toolchain.toml.
COPY rust-toolchain.toml ./
RUN rustup toolchain install
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
RUN --mount=type=cache,target=/root/.cargo/registry \
    --mount=type=cache,target=/src/target \
    cargo build --release --locked -p cotutelle-agent -p cotutelle-session \
    && cp target/release/cotutelle-agent target/release/cotutelle-session /

FROM scratch
COPY --from=build /cotutelle-agent /cotutelle-agent
COPY --from=build /cotutelle-session /cotutelle-session
