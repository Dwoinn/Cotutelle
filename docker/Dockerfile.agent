# syntax=docker/dockerfile:1

# Binaires de l'agent et de l'assistant de session pour Linux.
#
# L'agent est lié à la glibc 2.28 d'AlmaLinux 8 : il tourne sur Debian 10+,
# Ubuntu 20.04+, RHEL 8+, Fedora, openSUSE, Arch… L'assistant de session,
# lui, a ses fenêtres natives (GTK 4 / libadwaita, feature `gtk`) : il se
# construit sur AlmaLinux 9, qui fournit les en-têtes, et demande donc la
# glibc 2.34, GTK 4 et libadwaita 1 à l'exécution (Debian 12+, Ubuntu 22.04+,
# RHEL 9+). Sur une distribution plus ancienne, l'agent protège et garde ses
# notifications de base ; l'assistant ne démarre pas (D19).
#
#   docker buildx build -f docker/Dockerfile.agent --output type=local,dest=dist .
#
# dépose dist/cotutelle-agent et dist/cotutelle-session, pour l'architecture
# de la machine.

FROM almalinux:8 AS agent
RUN dnf install -y gcc && dnf clean all
ENV PATH=/root/.cargo/bin:$PATH
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --profile minimal --default-toolchain none
WORKDIR /src
# La version de Rust vient de rust-toolchain.toml.
COPY rust-toolchain.toml ./
RUN rustup toolchain install
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
RUN --mount=type=cache,target=/root/.cargo/registry \
    --mount=type=cache,target=/src/target,id=target-el8 \
    cargo build --release --locked -p cotutelle-agent \
    && cp target/release/cotutelle-agent /

# libadwaita-devel est dans le dépôt CRB (CodeReady Builder).
FROM almalinux:9 AS session
RUN dnf install -y 'dnf-command(config-manager)' \
    && dnf config-manager --set-enabled crb \
    && dnf install -y gcc pkgconf-pkg-config gtk4-devel libadwaita-devel \
    && dnf clean all
ENV PATH=/root/.cargo/bin:$PATH
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --profile minimal --default-toolchain none
WORKDIR /src
COPY rust-toolchain.toml ./
RUN rustup toolchain install
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
RUN --mount=type=cache,target=/root/.cargo/registry \
    --mount=type=cache,target=/src/target,id=target-el9 \
    cargo build --release --locked -p cotutelle-session \
    && cp target/release/cotutelle-session /

FROM scratch
COPY --from=agent /cotutelle-agent /cotutelle-agent
COPY --from=session /cotutelle-session /cotutelle-session
