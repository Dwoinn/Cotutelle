# syntax=docker/dockerfile:1
FROM rust:1-bookworm AS build
WORKDIR /src
COPY . .
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/src/target \
    cargo build --release -p cotutelle-server \
    && cp target/release/cotutelle-server /cotutelle-server

FROM gcr.io/distroless/cc-debian12:nonroot
COPY --from=build /cotutelle-server /usr/local/bin/cotutelle-server
VOLUME /data
ENV COTUTELLE_DATABASE=/data/cotutelle.db
# 8080 : API + web. 53 : DNS réseau local (phase 1, nécessite NET_BIND_SERVICE).
EXPOSE 8080 53/udp 53/tcp
ENTRYPOINT ["/usr/local/bin/cotutelle-server"]
